# Cargo build output, including standalone crate and example builds.
target/
__pycache__/
*.py[cod]
# Local environment settings and JavaScript dependencies.
.env
.env.*
!.env.example
# Machine-local package registry credentials.
/.cargo/credentials
/.cargo/credentials.toml
/.npmrc
/.netrc
/.pypirc
node_modules/
# Local agent state and editor settings.
/.claude/
/.codex/
/.idea/
/.vscode/
# Editor and operating-system temporary files.
*~
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
# Crash dumps and local profiling output.
/core
core.[0-9]*
*.core
*.dmp
/*.log
perf.data
perf.data.*
*.profraw
*.profdata
callgrind.out.*
cachegrind.out.*
*.er/
# Local captured diagnostics.
/m0.err
/m0.out
# tc39/test262 conformance suite (cloned on demand by scripts/test262-clone.sh) + its score report.
/test262/
/test262-report/
# Local web-platform-tests checkout and focused report.
/wpt/
/wpt-report/
# Official WebAssembly core specification checkout and generated runner report.
/wasm-spec/
/wasm-spec-report/
# Autobahn WebSocket Testsuite client reports.
/autobahn-reports/
# Local classic V8 benchmark fixtures.
/v8-v7/
# Local pinned third-party browser replay assets.
/browser-replay-fixtures/
# Machine-readable local performance reports.
/benchmark-results/
# Local debugger stack dumps.
/stack.txt
# Machine-specific installed production artifact record.
/benchmarks/accepted-production.json
# Local documentation and investigation notes; keep READMEs and agent guidance available.
*.md
!README.md
!/AGENTS.md
!/crates/trust-js-web/src/js/STREAMS_UPSTREAM.md
!/docs/architecture-outcome-20260929.md
!/docs/architecture-reassessment-20260928.md

