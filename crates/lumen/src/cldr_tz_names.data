อกเวลาคาซัคสถานตะวันตกเวลาเกาหลีเวลามาตรฐานเกาหลีเวลาออมแสงเกาหลีเวลาคอสไรเวลาครัสโนยาสค์เวลามาตรฐานครัสโนยาสค์เวลาฤดูร้อนครัสโนยาสค์เวลาคีร์กีซสถานเวลาลังกาเวลาหมู่เกาะไลน์เวลาลอร์ดโฮว์เวลามาตรฐานลอร์ดโฮว์เวลาออมแสงลอร์ดโฮว์เวลามาเก๊าเวลามาตรฐานมาเก๊าเวลาฤดูร้อนมาเก๊าเวลามากาดานเวลามาตรฐานมากาดานเวลาฤดูร้อนมากาดานเวลามาเลเซียเวลามัลดีฟส์เวลามาร์เคซัสเวลาหมู่เกาะมาร์แชลล์เวลามอริเชียสเวลามาตรฐานมอริเชียสเวลาฤดูร้อนของมอริเชียสเวลามอว์สันเวลาแปซิฟิกเม็กซิโกเวลามาตรฐานแปซิฟิกเม็กซิโกเวลาออมแสงแปซิฟิกเม็กซิโกเวลาอูลานบาตอร์เวลามาตรฐานอูลานบาตอร์เวลาฤดูร้อนอูลานบาตอร์เวลามอสโกเวลามาตรฐานมอสโกเวลาฤดูร้อนมอสโกเวลาพม่าเวลานาอูรูเวลาเนปาลเวลานิวแคลิโดเนียเวลามาตรฐานนิวแคลิโดเนียเวลาฤดูร้อนนิวแคลิโดเนียเวลานิวซีแลนด์เวลามาตรฐานนิวซีแลนด์เวลาออมแสงนิวซีแลนด์เวลานิวฟันด์แลนด์เวลามาตรฐานนิวฟันด์แลนด์เวลาออมแสงนิวฟันด์แลนด์เวลานีอูเอเวลาเกาะนอร์ฟอล์กเวลามาตรฐานเกาะนอร์ฟอล์กเวลาออมแสงเกาะนอร์ฟอล์กเวลาหมู่เกาะเฟอร์นันโดเวลามาตรฐานหมู่เกาะเฟอร์นันโดเวลาฤดูร้อนของหมู่เกาะเฟอร์นันโดเวลาหมู่เกาะมาเรียนาเหนือเวลาโนโวซีบีสค์เวลามาตรฐานโนโวซีบีสค์เวลาฤดูร้อนโนโวซีบีสค์เวลาออมสค์เวลามาตรฐานออมสค์เวลาฤดูร้อนออมสค์เวลาปากีสถานเวลามาตรฐานปากีสถานเวลาฤดูร้อนปากีสถานเวลาปาเลาเวลาปาปัวนิวกินีเวลาปารากวัยเวลามาตรฐานปารากวัยเวลาฤดูร้อนปารากวัยเวลาเปรูเวลามาตรฐานเปรูเวลาฤดูร้อนเปรูเวลาฟิลิปปินส์เวลามาตรฐานฟิลิปปินส์เวลาฤดูร้อนฟิลิปปินส์เวลาหมู่เกาะฟินิกซ์เวลาแซงปีแยร์และมีเกอลงเวลามาตรฐานแซงปีแยร์และมีเกอลงเวลาออมแสงของแซงปีแยร์และมีเกอลงเวลาพิตแคร์นเวลาโปนาเปเวลาเปียงยางเวลาคืยซิลออร์ดาเวลามาตรฐานคืยซิลออร์ดาเวลาฤดูร้อนคืยซิลออร์ดาเวลาเรอูนียงเวลาโรธีราเวลาซาคาลินเวลามาตรฐานซาคาลินเวลาฤดูร้อนซาคาลินเวลาซามาราเวลามาตรฐานซามาราเวลาฤดูร้อนซามาราเวลาซามัวเวลามาตรฐานซามัวเวลาฤดูร้อนซามัวเวลาเซเชลส์เวลาสิงคโปร์เวลาหมู่เกาะโซโลมอนเวลาเซาท์จอร์เจียเวลาซูรินาเมเวลาไซโยวาเวลาตาฮีตีเวลาไทเปเวลามาตรฐานไทเปเวลาออมแสงไทเปเวลาทาจิกิสถานเวลาโตเกเลาเวลาตองกาเวลามาตรฐานตองกาเวลาฤดูร้อนตองกาเวลาชุกเวลาตุรกีเวลามาตรฐานตุรกีเวลาฤดูร้อนตุรกีเวลาเติร์กเมนิสถานเวลามาตรฐานเติร์กเมนิสถานเวลาฤดูร้อนเติร์กเมนิสถานเวลาตูวาลูเวลาอุรุกวัยเวลามาตรฐานอุรุกวัยเวลาฤดูร้อนอุรุกวัยเวลาอุซเบกิสถานเวลามาตรฐานอุซเบกิสถานเวลาฤดูร้อนอุซเบกิสถานเวลาวานูอาตูเวลามาตรฐานวานูอาตูเวลาฤดูร้อนวานูอาตูเวลาเวเนซุเอลาเวลาวลาดีวอสตอคเวลามาตรฐานวลาดีวอสตอคเวลาฤดูร้อนวลาดีวอสตอคเวลาวอลโกกราดเวลามาตรฐานวอลโกกราดเวลาฤดูร้อนวอลโกกราดเวลาวอสตอคเวลาเกาะเวกเวลาวาลลิสและฟุตูนาเวลายาคุตสค์เวลามาตรฐานยาคุตสค์เวลาฤดูร้อนยาคุตสค์เวลาเยคาเตรินบูร์กเวลามาตรฐานเยคาเตรินบูร์กเวลาฤดูร้อนเยคาเตรินบูร์กเวลายูคอนเวลาสากลเชิงพิกัดเวลามาตรฐานไอร์แลนด์เวลาฤดูร้อนอังกฤษอาบีจานอักกราแอดดิสอาบาบาแอลเจียร์แอสมาราบามาโกบังกีบันจูลบิสเซาแบลนไทร์บราซซาวิลบูจุมบูราไคโรคาสซาบลางก้าเซวตาโกนากรีดาการ์ดาร์เอสซาลามจิบูตีดูอาลาเอลไอย์อุงฟรีทาวน์กาโบโรเนฮาราเรโจฮันเนสเบอร์กจูบาคัมพาลาคาร์ทูมคิกาลีกินชาซาลากอสลีเบรอวิลโลเมลูอันดาลูบัมบาชิลูซากามาลาโบมาปูโตมาเซรูอัมบาบาเนโมกาดิชูมันโรเวียไนโรเบียเอ็นจาเมนานีอาเมย์นูแอกชอตวากาดูกูปอร์โต-โนโวเซาตูเมตรีโปลีตูนิสวินด์ฮุกเอดักแองเคอเรจแองกิลลาแอนติกาอารากัวนาลาริโอจาริโอกาลเลกอสซัลตาซานฮวนซันลูอิสทูคูแมนอูชูเอียอารูบาอะซุนซิอองบาเยียบาเอียบันเดรัสบาร์เบโดสเบเลงเบลีซบลังค์-ซาบลอนบัววีชตาโบโกตาบอยซีบัวโนสไอเรสอ่าวแคมบริดจ์กัมปูกรันดีแคนคุนคาราคัสกาตามาร์กากาแยนเคย์แมนชิคาโกชีวาวาซิวดัดฮัวเรซคอรัลฮาร์เบอร์คอร์โดบาคอสตาริกาโกไยเกเครสตันกุยาบาคูราเซาดานมาร์กสฮาวน์ดอว์สันดอว์สัน ครีกเดนเวอร์ดีทรอยต์โดมินิกาเอดมันตันเอรูเนเปเอลซัลวาดอร์ฟอร์ตเนลสันฟอร์ตาเลซาเกลซเบย์กอดแธบกูสเบย์แกรนด์เติร์กเกรนาดากวาเดอลูปกัวเตมาลากัวยากิลกายอานาแฮลิแฟกซ์ฮาวานาเอร์โมซีโยนอกซ์, อินดีแอนามาเรงโก, อินดีแอนาปีเตอร์สเบิร์ก, อินดีแอนาเทลล์ซิตี, อินดีแอนาวีเวย์, อินดีแอนาวินเซนเนส, อินดีแอนาวินาแมค, อินดีแอนาอินเดียแนโพลิสอินูวิกอีกวาลิตจาเมกาจูจิวจูโนมอนติเซลโล, เคนตักกีคราเลนดิจค์ลาปาซลิมาลอสแองเจลิสลูส์วิลล์โลเวอร์พรินซ์ ควอเตอร์มาเซโอมานากัวมาเนาส์มาริโกต์มาร์ตินีกมาตาโมรอสมาซาทลานเมนดูซาเมโนมินีเมรีดาเมทลากาตละเม็กซิโกซิตีมีเกอลงมองตันมอนเตร์เรย์มอนเตวิเดโอมอนเซอร์รัตแนสซอนิวยอร์กนอมโนรอนฮาโบลาห์, นอร์ทดาโคตาเซนเตอร์, นอร์ทดาโคตานิวเซเลม, นอร์ทดาโคตาโอจินากาปานามาปารามาริโบฟินิกซ์ปอร์โตแปรงซ์พอร์ทออฟสเปนปอร์ตูเวลโยเปอโตริโกปุนตาอาเรนัสแรงกินอินเล็ตเรซีเฟริไจนาเรโซลูทรีโอบรังโกซันตาเรมซันติอาโกซานโต โดมิงโกเซาเปาลูสกอเรสไบซันด์ซิตกาเซนต์บาร์เธเลมีเซนต์จอนส์เซนต์คิตส์เซนต์ลูเซียเซนต์โธมัสเซนต์วินเซนต์สวิฟต์เคอร์เรนต์เตกูซิกัลปาทูเลทิฮัวนาโทรอนโตตอร์โตลาแวนคูเวอร์ไวต์ฮอร์สวินนิเพกยากูทัตเคซีย์เดวิสดูมองต์ดูร์วิลล์แมคควอรีมอว์สันแมคมัวโดพาล์เมอร์โรธีราไซโยวาโทรลวอสตอคลองเยียร์เบียนเอเดนอัลมาตีอัมมานอานาดีร์อัคตาอูอัคโทบีอาชกาบัตอทีราวแบกแดดบาห์เรนบากูกรุงเทพบาร์เนาว์เบรุตบิชเคกบรูไนโกลกาตาชิตาโคลัมโบดามัสกัสดากาดิลีดูไบดูชานเบแฟมากุสตากาซาเฮบรอนฮ่องกงฮอฟด์อีร์คุตสค์จาการ์ตาจายาปุระเยรูซาเลมคาบูลคามชัตกาการาจีกาตมันดุฮันดืยกาครัสโนยาร์สก์กัวลาลัมเปอร์กูชิงคูเวตมาเก๊ามากาดานมากัสซาร์มะนิลามัสกัตนิโคเซียโนโวคุซเนตสค์โนโวซิบิร์สก์โอมสก์ออรัลพนมเปญพอนเทียนักเปียงยางกาตาร์คอสตาเนย์ไคซีลอร์ดาย่างกุ้งริยาร์ดนครโฮจิมินห์ซาคาลินซามาร์กานด์โซลเซี่ยงไฮ้สิงคโปร์ซเรดเนคโคลิมสก์ไทเปทาชเคนต์ทบิลิซิเตหะรานทิมพูโตเกียวตอมสค์อูลานบาตอร์อุรุมชีอุสต์เนราเวียงจันทน์วลาดิโวสต็อกยาคุตสค์ยีคาเตอรินเบิร์กเยเรวานอะโซร์สเบอร์มิวดาคะเนรีเคปเวิร์ดแฟโรมาเดราเรคยาวิกเซาท์ จอร์เจียเซนต์เฮเลนาสแตนลีย์แอดิเลดบริสเบนโบรกเคนฮิลล์ดาร์วินยูคลาโฮบาร์ตลินดีแมนลอร์ดโฮว์เมลเบิร์นเพิร์ทซิดนีย์ไม่ทราบชื่อเมืองอัมสเตอดัมอันดอร์ราแอสตราคานเอเธนส์เบลเกรดเบอร์ลินบราติสลาวาบรัสเซลส์บูคาเรสบูดาเปสบุสซิงเง็นคีชีเนาโคเปนเฮเกนดับบลินยิบรอลตาร์เกิร์นซีย์เฮลซิงกิเกาะแมนอิสตันบูลเจอร์ซีย์คาลินิงกราดเคียฟคิรอฟลิสบอนลูบลิยานาลอนดอนลักเซมเบิร์กมาดริดมอลตามารีฮามน์มินสก์โมนาโกมอสโกออสโลปารีสพอดกอรีตซาปรากริกาโรมซามาราซานมารีโนซาราเยโวซาราทอฟซิมเฟอโรโปลสโกเปียโซเฟียสตอกโฮล์มทาลลินน์ติรานาอะลิยานอฟวาดุซวาติกันเวียนนาวิลนีอุสวอลโกกราดวอร์ซอซาเกร็บซูริคอันตานานาริโวชากัสคริสต์มาสโคโคสโคโมโรแกร์เกอลองมาเอมัลดีฟส์มอริเชียสมาโยเตเรอูนียงอาปีอาโอคแลนด์บูเกนวิลล์แชทัมอีสเตอร์เอฟาเตแคนทอนฟาเคาโฟฟิจิฟูนะฟูตีกาลาปาโกสแกมเบียร์กัวดัลคานัลกวมโฮโนลูลูคิริทิมาตีคอสไรควาจาเลนมาจูโรมาร์เคซัสมิดเวย์นาอูรูนีอูเอนอร์ฟอล์กนูเมอาปาโก ปาโกปาเลาพิตแคร์นโปนาเปพอร์ตมอร์สบีราโรตองกาไซปันตาฮีตีตาระวาตองกาตาปูทรักเวกวาลลิสFaroe+HH.mm;-HH.mmGMT {0}{0} (lokalni čas){0} (standardni čas){0